# TripList environment — every variable here is optional.
# `make setup` copies this to .env, and `make db-up` fills in DATABASE_URL /
# BETTER_AUTH_SECRET / BETTER_AUTH_URL automatically (appended, never overwritten).
# Without DATABASE_URL the app runs guest-only (auth disabled); without
# RESEND_API_KEY invite/share emails are skipped.
# The server reads this via `node --env-file-if-exists=.env` (`make dev` / `make start`).

# Postgres connection string. Enables accounts/auth (better-auth).
# `make db-up` starts a local Postgres matching this URL and writes it here.
#DATABASE_URL=postgres://triplist:triplist@localhost:5442/triplist

# Required once DATABASE_URL is set — session-signing secret for better-auth.
# `make db-up` generates one; or: openssl rand -hex 32
#BETTER_AUTH_SECRET=

# Base URL used in auth callbacks and emailed links (defaults to https://triplist.dev).
# http://localhost:5199 for `make dev`; use http://localhost:8080 if testing `make start`.
#BETTER_AUTH_URL=http://localhost:5199

# Resend credentials for invite/share emails.
#RESEND_API_KEY=
#RESEND_FROM=TripList <invites@triplist.dev>

# Port for the production server (default 8080).
#PORT=8080
